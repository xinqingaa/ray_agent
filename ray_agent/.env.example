# 项目基础设置
ENV=development
LOG_LEVEL=DEBUG
SQLALCHEMY_ECHO=0
APP_CONFIG_FILEPATH=config.yaml
# 仅密钥走环境变量；模型名、地址、温度等在 api/config.yaml 或设置页修改
LLM_API_KEY=

# 数据库相关的配置
SQLALCHEMY_DATABASE_URI=postgresql+asyncpg://postgres:postgres@localhost:5432/manus

# Redis相关配置
REDIS_HOST=localhost
REDIS_PORT=8001
REDIS_DB=0
REDIS_PASSWORD=

# 文件存储：local 写本地磁盘，cos 使用腾讯云对象存储
FILE_STORAGE_BACKEND=local
FILE_STORAGE_LOCAL_DIR=data/files

# 腾讯云cos相关配置（仅 FILE_STORAGE_BACKEND=cos 时必填）
COS_SECRET_ID=
COS_SECRET_KEY=
COS_REGION=
COS_SCHEME=https
COS_BUCKET=
COS_DOMAIN=

# 沙箱配置
SANDBOX_ADDRESS=
SANDBOX_IMAGE=mooc-manus-sandbox
SANDBOX_NAME_PREFIX=mooc-manus-sandbox
# 注入容器的变量名是 SERVER_TIMEOUT_MINUTES，由沙箱按分钟回收
SANDBOX_TTL_MINUTES=60
# 仅动态创建容器时生效：内存 MiB、CPU 核数、进程数上限
SANDBOX_MEMORY_MB=2048
SANDBOX_CPUS=2
SANDBOX_PIDS_LIMIT=512
SANDBOX_NETWORK=mooc-manus-network
SANDBOX_CHROME_ARGS=
SANDBOX_HTTPS_PROXY=
SANDBOX_HTTP_PROXY=
SANDBOX_NO_PROXY=